export const questions = [
  {
    id: 'q-1',
    title: 'How do I stop my dog from pulling on the leash in busy streets?',
    body: 'Milo is fine in the park but the moment we hit Kastanienallee he pulls constantly. Harness helps a little but not enough. What actually worked for you?',
    category: 'Training',
    author: 'Mia',
    createdAt: hoursAgo(4),
    votes: 24,
    answers: [
      { id: 'a-1', author: 'Jonas', body: 'Stop-and-go worked for us. The second the leash goes tight, you stop. No word, no pull back. It is painfully slow for a week and then it clicks.', votes: 17, accepted: true, createdAt: hoursAgo(3) },
      { id: 'a-2', author: 'Katrin', body: 'Reward heavily whenever he is beside your leg without you asking. Most dogs pull because walking politely was never the interesting option.', votes: 9, accepted: false, createdAt: hoursAgo(2) },
    ],
  },
  {
    id: 'q-2',
